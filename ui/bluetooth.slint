import { ScrollView, LineEdit, Button, CheckBox } from "std-widgets.slint";

export struct AudioProfile {
    name: string,
    description: string,
    active: bool,
    available: bool,
}

export struct BatteryInfo {
    label: string,
    percentage: int,
}

export struct BluetoothDevice {
    name: string,
    address: string,
    connected: bool,
    paired: bool,
    trusted: bool,
    rssi: int,
    battery: int,
    batteries: [BatteryInfo],
    icon: string,
    icon_color: color,
    audio_profiles: [AudioProfile],
}

export global Palette {
    in-out property <color> background: #09090b88; // 50% opacity for glassmorphism
    in-out property <color> card-bg: #18181b;
    in-out property <color> accent: #00f0ff;
    in-out property <color> foreground: #f8fafc;
    in-out property <color> secondary-fg: #a1a1aa;
    in-out property <color> separator: #27272a;
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked;
    
    height: 28px;
    background: primary ? (enabled ? Palette.accent : Palette.accent.with-alpha(0.3)) : transparent;
    border-radius: 4px;
    border-width: 1px;
    border-color: danger ? #ff0055.with-alpha(0.8) : Palette.accent.with-alpha(0.8);
    
    states [
        hover when touch.has-hover && enabled : {
            background: primary ? Palette.accent.brighter(20%) : (danger ? #ff0055.with-alpha(0.2) : Palette.accent.with-alpha(0.2));
        }
        pressed when touch.pressed && enabled : {
            background: primary ? Palette.accent.darker(20%) : (danger ? #ff0055.with-alpha(0.4) : Palette.accent.with-alpha(0.4));
        }
    ]

    touch := TouchArea {
        clicked => { if (enabled) { root.clicked(); } }
    }

    Text {
        text: root.text;
        color: primary ? Palette.background : (danger ? #ff0055 : Palette.accent);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1.5px;
    }
}

// Icons: Nerd Font glyphs draw up to ~1.6x wider than their advance width and
// Text clips to its own box, so a Text sized to the glyph loses the right half
// of the icon. Give every icon Text a width of at least 1.3x its font size (or
// the whole button) and centre it.

// A switch whose state belongs to its owner: a click only reports the
// requested state. A switch that flips itself overwrites its binding to
// window state, and after one click stops following the real adapter.
component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    // Outlined like the CONNECT/DISCONNECT buttons rather than a solid fill.
    width: 38px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.checked ? Palette.accent.with-alpha(0.7) : Palette.separator.brighter(30%);
    background: root.checked ? Palette.accent.with-alpha(0.25) : Palette.foreground.with-alpha(0.06);
    opacity: root.enabled ? 1.0 : 0.4;
    animate background, border-color { duration: 200ms; }

    Rectangle {
        x: root.checked ? 21px : 3px;
        y: 3px;
        width: 14px;
        height: 14px;
        background: root.checked ? Palette.accent : Palette.secondary-fg;
        border-radius: 7px;
        animate x { duration: 200ms; easing: ease-in-out; }
        animate background { duration: 200ms; }
    }

    TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.toggled(!root.checked); } }
    }
}

// One labelled switch in the settings panel.
component SettingRow inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    in property <bool> checked;
    callback toggled(bool);

    spacing: 10px;
    height: 28px;
    Text {
        text: root.icon;
        width: 22px;
        font-size: 14px;
        color: Palette.secondary-fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        text: root.text;
        horizontal-stretch: 1;
        font-size: 12px;
        font-weight: 700;
        color: Palette.foreground;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        Switch {
            checked: root.checked;
            toggled(on) => { root.toggled(on); }
        }
    }
}

component HeaderButton inherits Rectangle {
    in property <string> icon;
    // Highlighted, e.g. while its panel is open.
    in property <bool> active: false;
    // Working: shown in the accent colour and ignores clicks.
    in property <bool> busy: false;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.active ? Palette.accent.with-alpha(0.6) : Palette.separator;
    background: root.active
        ? Palette.accent.with-alpha(touch.has-hover ? 0.28 : 0.16)
        : (touch.has-hover ? Palette.card-bg.brighter(20%) : Palette.card-bg);
    animate background, border-color { duration: 150ms; }

    Text {
        text: root.icon;
        width: 100%;
        height: 100%;
        font-size: 16px;
        color: root.busy || root.active ? Palette.accent : Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: root.busy ? default : pointer;
        clicked => { if (!root.busy) { root.clicked(); } }
    }
}

// The adapter power control for the header: same footprint as the buttons
// next to it, lit when on, dimmed and crossed out when off.
component RadioButton inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> icon-on;
    in property <string> icon-off;
    callback toggled(bool);

    width: 32px;
    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.checked ? Palette.accent.with-alpha(0.6) : Palette.separator;
    background: root.checked
        ? Palette.accent.with-alpha(touch.has-hover ? 0.28 : 0.16)
        : (touch.has-hover && root.enabled ? Palette.card-bg.brighter(20%) : Palette.card-bg);
    opacity: root.enabled ? 1.0 : 0.4;
    animate background, border-color { duration: 150ms; }

    Text {
        text: root.checked ? root.icon-on : root.icon-off;
        width: 100%;
        height: 100%;
        font-size: 16px;
        color: root.checked ? Palette.accent : Palette.secondary-fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.toggled(!root.checked); } }
    }
}

// A full-width notice card with an optional action, for empty states.
component NoticeCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> detail;
    in property <string> action: "";
    callback action-clicked;

    background: Palette.card-bg;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.separator;

    HorizontalLayout {
        padding: 12px;
        spacing: 16px;
        Text {
            text: root.icon;
            width: 32px;
            font-size: 22px;
            color: Palette.secondary-fg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 800;
                color: Palette.foreground;
            }
            Text {
                text: root.detail;
                font-size: 10px;
                font-weight: 700;
                color: Palette.secondary-fg;
                wrap: word-wrap;
            }
        }
        if (root.action != "") : VerticalLayout {
            alignment: center;
            ActionButton {
                text: root.action;
                width: 90px;
                clicked => { root.action-clicked(); }
            }
        }
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> danger: false;
    callback clicked;

    height: 36px;
    border-radius: 8px;
    background: touch.has-hover ? (danger ? #ed333b.with-alpha(0.1) : Palette.foreground.with-alpha(0.05)) : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        
        Text {
            text: root.icon;
            width: 22px;
            color: danger ? #ed333b : Palette.secondary-fg;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: danger ? #ed333b : Palette.foreground;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ContextMenu inherits Rectangle {
    in property <string> address;
    in property <bool> is_paired;
    in property <bool> is_trusted;
    in property <[AudioProfile]> audio_profiles;

    callback toggle_trust(string, bool);
    callback toggle_pair(string, bool);
    callback remove(string);
    callback select_audio_profile(string, string);
    callback closed;

    width: 220px;
    height: menu-layout.preferred-height;
    background: Palette.card-bg;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.separator;
    drop-shadow-blur: 20px;
    drop-shadow-color: rgba(0,0,0,0.6);
    property <bool> show_profiles: false;

    menu-layout := VerticalLayout {
        padding: 6px;
        spacing: 4px;

        if (audio_profiles.length > 0 && !root.show_profiles) : MenuItem {
            text: "Audio profiles";
            icon: "󰋋";
            clicked => { root.show_profiles = true; }
        }

        if (audio_profiles.length > 0 && root.show_profiles) : Rectangle {
            background: Palette.foreground.with-alpha(0.05);
            border-radius: 8px;
            height: audio_profiles_layout.preferred-height + 12px;
            width: 208px;

            audio_profiles_layout := VerticalLayout {
                padding: 6px;
                spacing: 4px;

                TouchArea {
                    clicked => { root.show_profiles = false; }
                    height: 16px;
                    Text {
                        text: "Audio profiles";
                        font-size: 9px;
                        font-weight: 900;
                        color: Palette.secondary-fg;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                }

                for profile in audio_profiles : Rectangle {
                    height: 28px;
                    background: profile.active ? Palette.accent.with-alpha(0.1) : (prof-touch.has-hover ? Palette.foreground.with-alpha(0.05) : transparent);
                    border-radius: 4px;

                    prof-touch := TouchArea {
                        clicked => { root.select_audio_profile(root.address, profile.name); root.closed(); }
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;

                        Text {
                            text: profile.active ? "󰄬" : (profile.available ? "󰦝" : "󰂭");
                            width: 18px;
                            color: profile.active ? Palette.accent : Palette.secondary-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 12px;
                        }

                        Text {
                            text: profile.description;
                            color: profile.active ? Palette.foreground : Palette.secondary-fg;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            width: 208px;
            background: Palette.separator;
            visible: audio_profiles.length > 0;
        }

        MenuItem {
            text: is_trusted ? "Untrust" : "Trust";
            icon: is_trusted ? "󰗚" : "󰗙";
            clicked => { root.toggle_trust(root.address, !root.is_trusted); root.closed(); }
        }

        MenuItem {
            text: is_paired ? "Unpair" : "Pair";
            icon: "󰒄";
            clicked => { root.toggle_pair(root.address, !root.is_paired); root.closed(); }
        }

        MenuItem {
            text: "Remove";
            icon: "󰆴";
            danger: true;
            clicked => { root.remove(root.address); root.closed(); }
        }
    }
}

export component AppWindow inherits Window {
    in property <[BluetoothDevice]> devices;
    in property <string> status_msg: "Ready";
    in property <bool> is_scanning: false;
    in property <bool> show_settings: false;
    in-out property <bool> pywal_enabled: false;
    // Adapter state, polled from BlueZ. The power switch sets it at once for
    // feedback; the next poll corrects it if the change failed.
    in-out property <bool> bluetooth_enabled: true;
    in property <bool> has_adapter: true;
    in property <string> expanded_address: "";

    callback connect(string);
    callback disconnect(string);
    callback refresh();
    callback toggle_settings();
    callback toggle_pywal(bool);
    callback toggle_bluetooth(bool);
    
    callback toggle_trust(string, bool);
    callback toggle_pair(string, bool);
    callback remove_device(string);
    callback select_audio_profile(string, string);
    callback expand_device(string);

    title: "AuraLink Bluetooth";
    min-width: 400px;
    max-width: 400px;
    min-height: 600px;
    max-height: 600px;
    background: Palette.background;
    default-font-family: "JetBrainsMono Nerd Font";
    no-frame: true;
    always-on-top: true;

    property <length> context_menu_x: 0;
    property <length> context_menu_y: 0;
    in-out property <bool> show_context_menu: false;
    property <string> context_address: "";
    property <bool> context_is_paired: false;
    property <bool> context_is_trusted: false;
    property <[AudioProfile]> context_audio_profiles: [];

    // Overlay handler
    TouchArea {
        width: 100%; height: 100%;
        visible: show_context_menu;
        clicked => { 
            show_context_menu = false; 
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        // Header
        HorizontalLayout {
            padding-bottom: 8px;
            VerticalLayout {
                Text {
                    text: "AURA//BT";
                    font-size: 22px;
                    font-weight: 900;
                    color: Palette.accent;
                    letter-spacing: 2px;
                }
                Text {
                    text: "SYS.STATUS: " + status_msg;
                    font-size: 10px;
                    font-weight: 700;
                    color: Palette.secondary-fg;
                    letter-spacing: 1px;
                }
            }
            
            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                // Adapter power on/off.
                RadioButton {
                    checked: has_adapter && bluetooth_enabled;
                    enabled: has_adapter;
                    icon-on: "󰂯";
                    icon-off: "󰂲";
                    toggled(on) => {
                        bluetooth_enabled = on;
                        toggle_bluetooth(on);
                    }
                }
                HeaderButton {
                    icon: "󰑐";
                    busy: is_scanning;
                    clicked => { refresh(); }
                }
                HeaderButton {
                    icon: "󰒓";
                    active: show_settings;
                    clicked => { toggle_settings(); }
                }
            }
        }

        if (show_settings) : Rectangle {
            background: Palette.card-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.separator;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Text {
                    text: "SETTINGS";
                    font-size: 10px;
                    font-weight: 900;
                    color: Palette.secondary-fg;
                    letter-spacing: 2px;
                }
                SettingRow {
                    icon: "󰏘";
                    text: "Pywal Auto-Sync";
                    checked: pywal_enabled;
                    toggled(on) => {
                        pywal_enabled = on;
                        toggle_pywal(on);
                    }
                }
            }
        }

        ScrollView {
            VerticalLayout {
                spacing: 16px;
                alignment: start;

                // Devices Section
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "DEVICES";
                        font-size: 10px;
                        font-weight: 900;
                        color: Palette.secondary-fg;
                        letter-spacing: 2px;
                    }

                    if (!has_adapter) : NoticeCard {
                        icon: "󰂲";
                        title: "No Bluetooth adapter";
                        detail: "BlueZ reports no adapter. Check that bluetooth.service is running.";
                    }

                    if (has_adapter && !bluetooth_enabled) : NoticeCard {
                        icon: "󰂲";
                        title: "Bluetooth is off";
                        detail: "Turn it on to see and connect devices";
                        action: "TURN ON";
                        action-clicked => {
                            bluetooth_enabled = true;
                            toggle_bluetooth(true);
                        }
                    }

                    if (has_adapter && bluetooth_enabled && devices.length == 0) : Text {
                        text: is_scanning ? "Searching for devices..." : "No devices yet. Press refresh to scan.";
                        font-size: 11px;
                        font-weight: 700;
                        color: Palette.secondary-fg;
                        wrap: word-wrap;
                    }

                    if (has_adapter && bluetooth_enabled) : VerticalLayout {
                        spacing: 8px;
                        for dev[idx] in devices : Rectangle {
                            background: dev.connected ? Palette.accent.with-alpha(0.1) : (touch.has-hover ? Palette.card-bg.brighter(10%) : Palette.card-bg);
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: dev.connected ? Palette.accent : (touch.has-hover ? Palette.separator.brighter(20%) : Palette.separator);
                            animate background { duration: 200ms; easing: ease-in-out; }
                            animate border-color { duration: 200ms; easing: ease-in-out; }
                            
                            touch := TouchArea {
                                clicked => {
                                    if (dev.connected) {
                                        expand_device(dev.address == expanded_address ? "" : dev.address);
                                    }
                                }
                            }

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 16px;
                                    
                                    // 1. Icon
                                    VerticalLayout {
                                        alignment: center;
                                        width: 32px;
                                        Text {
                                            text: dev.icon;
                                            font-size: 22px;
                                            color: dev.icon_color;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    // 2. Details
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Text {
                                                text: dev.name != "" ? dev.name : dev.address;
                                                font-size: 14px;
                                                font-weight: 800;
                                                color: Palette.foreground;
                                            }
                                            if (dev.paired) : Text {
                                                text: "󰒄";
                                                width: 18px;
                                                horizontal-alignment: center;
                                                font-size: 12px;
                                                color: Palette.accent;
                                                vertical-alignment: center;
                                            }
                                            for bat in dev.batteries : Text {
                                                text: "󰁹 " + (bat.label != "" ? bat.label + " " : "") + bat.percentage + "%";
                                                font-size: 10px;
                                                font-weight: 900;
                                                color: bat.percentage < 20 ? #ff0055 : (bat.percentage < 50 ? #f5c211 : #00ffaa);
                                                vertical-alignment: center;
                                            }
                                        }
                                        
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Text {
                                                text: dev.address;
                                                font-size: 10px;
                                                font-weight: 800;
                                                color: Palette.secondary-fg;
                                                vertical-alignment: center;
                                            }
                                            if (dev.rssi != 0) : Text {
                                                text: "/// " + dev.rssi + " dBm";
                                                font-size: 10px;
                                                color: Palette.separator;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    
                                    Rectangle {} // Flexible Spacer
                                    
                                    // 3. Actions
                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 12px;
                                        
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 24px;
                                                height: 24px;
                                                background: context-touch.has-hover ? Palette.foreground.with-alpha(0.1) : transparent;
                                                border-radius: 4px;
                                                Text {
                                                    text: "󰇘";
                                                    width: 100%;
                                                    height: 100%;
                                                    font-size: 18px;
                                                    color: Palette.foreground;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                context-touch := TouchArea {
                                                    clicked => {
                                                        context_address = dev.address;
                                                        context_is_paired = dev.paired;
                                                        context_is_trusted = dev.trusted;
                                                        context_audio_profiles = dev.audio_profiles;
                                                        context_menu_x = self.absolute-position.x - 180px;
                                                        context_menu_y = self.absolute-position.y + 20px;
                                                        show_context_menu = true;
                                                    }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            if (dev.connected) : ActionButton {
                                                text: "DISCONNECT";
                                                primary: false;
                                                danger: true;
                                                width: 90px;
                                                clicked => { disconnect(dev.address); }
                                            }
                                            if (!dev.connected) : ActionButton {
                                                text: "CONNECT";
                                                width: 90px;
                                                clicked => { connect(dev.address); }
                                            }
                                        }
                                    }
                                }

                                if (dev.address == expanded_address && dev.audio_profiles.length > 0) : VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 8px;
                                    
                                    Text {
                                        text: "AUDIO PROFILES";
                                        font-size: 9px;
                                        font-weight: 900;
                                        color: Palette.secondary-fg;
                                        letter-spacing: 1px;
                                    }

                                    for profile in dev.audio_profiles : Rectangle {
                                        height: 32px;
                                        background: profile.active ? Palette.accent.with-alpha(0.1) : (prof-touch.has-hover ? Palette.foreground.with-alpha(0.05) : transparent);
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: profile.active ? Palette.accent.with-alpha(0.5) : transparent;
                                        
                                        prof-touch := TouchArea {
                                            clicked => { select_audio_profile(dev.address, profile.name); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            
                                            Text {
                                                text: profile.active ? "󰄬" : (profile.available ? "󰦝" : "󰂭");
                                                width: 21px;
                                                color: profile.active ? Palette.accent : Palette.secondary-fg;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                font-size: 14px;
                                            }
                                            
                                            Text {
                                                text: profile.description;
                                                color: profile.active ? Palette.foreground : Palette.secondary-fg;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Context Menu Overlay
    if (show_context_menu) : ContextMenu {
        x: Math.min(context_menu_x, root.width - self.width - 10px);
        y: Math.min(context_menu_y, root.height - self.height - 10px);
        address: context_address;
        is_paired: context_is_paired;
        is_trusted: context_is_trusted;
        audio_profiles: context_audio_profiles;
        toggle_trust(a, t) => { toggle_trust(a, t); }
        toggle_pair(a, p) => { toggle_pair(a, p); }
        remove(a) => { remove_device(a); }
        select_audio_profile(a, p) => { select_audio_profile(a, p); }
        closed => { show_context_menu = false; }
    }
}
